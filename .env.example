# Copia este archivo a ".env" (no versionado) y define un valor real antes de
# levantar el stack con docker-compose. No pongas el valor real en este archivo
# de ejemplo ni lo subas al repositorio.
#
# Generar una clave aleatoria segura, por ejemplo:
#   openssl rand -base64 48
JWT_KEY=

# Host y puerto donde se publica el servicio "app" (HTTP directo, ver docker-compose.yml).
# Docker exige una IP real como bind host — "localhost" como string no es válido ahí — así
# que 127.0.0.1 es el valor por defecto; es lo mismo que resuelve http://localhost:<puerto>
# desde esta misma máquina. Si necesitás que sea alcanzable desde otras máquinas de la red,
# cambiá APP_HOST a 0.0.0.0 (con cuidado: eso lo expone más allá de este equipo).
APP_HOST=127.0.0.1
APP_PORT=8080

# M6: opcionales — dejalas vacías para seguir sin envío de correo (comportamiento actual,
# EmailService se salta el envío si Email:SmtpHost/Username quedan vacíos). Si necesitás mandar
# correos reales desde Docker, completá estas acá (nunca en docker-compose.yml ni en
# appsettings.json). Con Gmail, EMAIL_PASSWORD es un "App Password" (myaccount.google.com/apppasswords),
# no la contraseña de la cuenta.
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=

# M6: solo hace falta si vas a usar una cuenta real de Azure Storage en vez del emulador local
# (Azurite, ya levantado por este mismo docker-compose) — dejala vacía para seguir usando Azurite.
AZURE_BLOB_CONNECTION_STRING=
