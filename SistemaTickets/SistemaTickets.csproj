<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b3f2e6d4-7c1a-4e9b-9f5d-2a8c6e1d4f70</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- M2: lista de contraseñas comunes/filtradas, embebida en el ensamblado (no un archivo
         suelto en el output) para que esté disponible sin importar cómo se publique/despliegue. -->
    <None Remove="Infrastructure/Security/CommonPasswords.txt" />
    <EmbeddedResource Include="Infrastructure/Security/CommonPasswords.txt">
      <LogicalName>SistemaTickets.CommonPasswords.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="FluentNHibernate" Version="3.5.0" />
	<PackageReference Include="NHibernate" Version="5.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
  </ItemGroup>

</Project>

