@model SistemaTickets.Models.Auth.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LoginLayout";
}

<div class="login-wrapper">

    <div class="login-card">

        @* Panel izquierdo *@
        <div class="login-left">
            <div class="login-left-content">
                <img src="~/images/logo.png" alt="TT Soluciones" class="login-logo mb-4" />
                <h2 class="login-welcome">Bienvenido</h2>
                <p class="login-subtitle">Sistema de gestión de tickets<br />y soporte técnico</p>
            </div>
            <div class="login-circle login-circle-1"></div>
            <div class="login-circle login-circle-2"></div>
            <div class="login-circle login-circle-3"></div>
        </div>

        @* Panel derecho *@
        <div class="login-right">
            <div class="login-form-wrapper">
                <h3 class="login-title">Iniciar sesión</h3>
                <p class="login-desc text-muted mb-4">Ingresa tus credenciales para continuar</p>

                <form asp-action="Login" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <div class="login-input-group">
                            <span class="login-input-icon">👤</span>
                            <input asp-for="Login"
                                   class="login-input"
                                   placeholder="Usuario, correo o teléfono"
                                   autocomplete="username" />
                        </div>
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="login-input-group">
                            <span class="login-input-icon">🔒</span>
                            <input asp-for="Password"
                                   id="passwordInput"
                                   class="login-input"
                                   placeholder="Contraseña"
                                   autocomplete="current-password" />
                            <button type="button" class="login-show-btn" onclick="togglePassword()">
                                <span id="showLabel">MOSTRAR</span>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-login w-100">
                        Ingresar
                    </button>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const label = document.getElementById('showLabel');
            if (input.type === 'password') {
                input.type = 'text';
                label.textContent = 'OCULTAR';
            } else {
                input.type = 'password';
                label.textContent = 'MOSTRAR';
            }
        }
    </script>
}
