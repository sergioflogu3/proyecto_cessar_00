@model SistemaTickets.Models.Tickets.TicketIndexViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Tickets";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
}

@Html.AntiForgeryToken()

<div class="page-header">
    <div>
        <h1 class="page-title">Tickets de Soporte</h1>
        <small class="page-subtitle">
            Mostrando @Model.DesdeRegistro–@Model.HastaRegistro de @Model.TotalRegistros tickets
        </small>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary btn-sm px-3">+ Nuevo Ticket</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Filtros *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-6 col-lg-4">
                <label for="filtroSearch" class="form-label small text-muted mb-1">Buscar</label>
                <input type="text" id="filtroSearch" name="search" value="@Model.Search"
                       class="form-control form-control-sm"
                       placeholder="Título o descripción..." />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="filtroEstado" class="form-label small text-muted mb-1">Estado</label>
                <select id="filtroEstado" name="estadoId" class="form-select form-select-sm">
                    <option value="">Todos los estados</option>
                    @foreach (var e in Model.Estados)
                    {
                        <option value="@e.Id" selected="@(Model.FiltroEstado == e.Id)">@e.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-2">
                <label for="filtroPrioridad" class="form-label small text-muted mb-1">Prioridad</label>
                <select id="filtroPrioridad" name="prioridadId" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var p in Model.Prioridades)
                    {
                        <option value="@p.Id" selected="@(Model.FiltroPrioridad == p.Id)">@p.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-3 acciones-form d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros" aria-label="Limpiar filtros">✕</a>
            </div>
        </form>
    </div>
</div>

@* Tabla *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 tabla-apilable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width:60px">#</th>
                        <th>Título</th>
                        <th>Estado</th>
                        <th>Prioridad</th>
                        <th>Categoría</th>
                        @if (role is "Administrador" or "Supervisor")
                        {
                            <th>Creado por</th>
                            <th>Asignado a</th>
                        }
                        <th>Creado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Tickets.Any())
                    {
                        <tr>
                            <td colspan="9" class="fila-vacia p-0">
                                <partial name="_EstadoVacio" model='("fa-solid fa-inbox", "No se encontraron tickets.", (string?)null, (string?)null)' />
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Model.Tickets)
                        {
                            <tr>
                                <td data-label="#" class="ps-4 text-muted small">@t.Id</td>
                                <td data-label="Título">
                                    <a asp-action="Details" asp-route-id="@t.Id"
                                       class="fw-semibold text-decoration-none text-dark">
                                        @t.Titulo
                                    </a>
                                </td>
                                <td data-label="Estado">
                                    <partial name="_BadgeEstado" model="(t.Estado.Nombre, t.Estado.Color)" />
                                </td>
                                <td data-label="Prioridad">
                                    @if (t.Prioridad != null)
                                    {
                                        <partial name="_BadgeEstado" model="(t.Prioridad.Nombre, t.Prioridad.Color)" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Sin prioridad</span>
                                    }
                                </td>
                                <td data-label="Categoría" class="text-muted small">@(t.Categoria?.Nombre ?? "—")</td>
                                @if (role is "Administrador" or "Supervisor")
                                {
                                    <td data-label="Creado por" class="text-muted small">
                                        @t.CreadoPor.Nombre @t.CreadoPor.Apellido
                                    </td>
                                    <td data-label="Asignado a" class="text-muted small">
                                        @(t.AsignadoA is null ? "—" : $"{t.AsignadoA.Nombre} {t.AsignadoA.Apellido}")
                                    </td>
                                }
                                <td data-label="Creado" class="text-muted small">
                                    @t.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-4 celda-acciones">
                                    <a asp-action="Details" asp-route-id="@t.Id"
                                       class="btn btn-outline-primary btn-sm" title="Ver" aria-label="Ver">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Paginación *@
@{
    Func<int, string> urlPagina = n =>
        "?page=" + n + "&search=" + Uri.EscapeDataString(Model.Search ?? "") +
        "&estadoId=" + Model.FiltroEstado + "&prioridadId=" + Model.FiltroPrioridad;
}
<partial name="_Paginacion" model="(Model.PaginaActual, Model.TotalPaginas, urlPagina)" />
