@model SistemaTickets.Models.Supervisor.SeguimientoViewModel

@{
    ViewData["Title"] = "Seguimiento de Tickets";
    // RF-5: como máximo 8 campos visibles por tarjeta en móvil (Técnico + estados + Total).
    // Los estados a partir del 7.º (índice 6) van al bloque plegable.
    const int MaxEstadosVisibles = 6;
    var hayPlegado = Model.Estados.Count > MaxEstadosVisibles;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Seguimiento de Tickets</h1>
        <small class="page-subtitle">Estado general de tickets activos por técnico y prioridad</small>
    </div>
</div>

@* ── KPIs resumen ───────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-6">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="text-muted small mb-1">Tickets activos</div>
            <div class="fs-2 fw-bold text-primary">@Model.TotalActivos</div>
        </div>
    </div>
    <div class="col-6 col-md-6">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="text-muted small mb-1">Sin asignar</div>
            <div class="fs-2 fw-bold @(Model.SinAsignar > 0 ? "text-warning" : "text-success")">
                @Model.SinAsignar
            </div>
        </div>
    </div>
</div>

@* ── Tabla por técnico ──────────────────────────────────────────────── *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center gap-2">
        <i class="fa-solid fa-id-badge text-primary"></i>
        <span class="fw-semibold">Tickets por técnico</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.PorTecnico.Any())
        {
            <partial name="_EstadoVacio" model='("fa-solid fa-inbox", "No hay tickets activos.", (string?)null, (string?)null)' />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 tabla-apilable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Técnico</th>
                            @foreach (var estado in Model.Estados)
                            {
                                <th class="text-center">@estado</th>
                            }
                            <th class="text-center pe-4">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in Model.PorTecnico)
                        {
                            <tr>
                                <td data-label="Técnico" class="ps-4 fw-semibold @(fila.Nombre == "(Sin asignar)" ? "text-muted fst-italic" : "")">
                                    <span class="celda-valor">
                                        @if (fila.Nombre != "(Sin asignar)")
                                        {
                                            <i class="fa-solid fa-user text-secondary" aria-hidden="true"></i>
                                        }
                                        <span>@fila.Nombre</span>
                                    </span>
                                </td>
                                @for (var i = 0; i < Model.Estados.Count; i++)
                                {
                                    var estado = Model.Estados[i];
                                    var count = fila.PorEstado.GetValueOrDefault(estado, 0);
                                    <td data-label="@estado" class="text-center@(i >= MaxEstadosVisibles ? " td-secundario" : "")">
                                        @if (count > 0)
                                        {
                                            <span class="badge bg-secondary">@count</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                }
                                <td data-label="Total" class="text-center pe-4">
                                    <span class="celda-valor">
                                        <span class="badge bg-primary rounded-pill">@fila.Total</span>
                                        @if (hayPlegado)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm btn-plegar" aria-expanded="false">Ver más</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-semibold">
                        <tr>
                            <td class="ps-4 fila-total-etiqueta">Total</td>
                            @for (var i = 0; i < Model.Estados.Count; i++)
                            {
                                var estado = Model.Estados[i];
                                var total = Model.PorTecnico.Sum(f => f.PorEstado.GetValueOrDefault(estado, 0));
                                <td data-label="@estado" class="text-center@(i >= MaxEstadosVisibles ? " td-secundario" : "")">@total</td>
                            }
                            <td data-label="Total" class="text-center pe-4">
                                <span class="celda-valor">
                                    @Model.TotalActivos
                                    @if (hayPlegado)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm btn-plegar" aria-expanded="false">Ver más</button>
                                    }
                                </span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@* ── Distribución por prioridad ─────────────────────────────────────── *@
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center gap-2">
        <i class="fa-solid fa-flag text-danger"></i>
        <span class="fw-semibold">Distribución por prioridad</span>
    </div>
    <div class="card-body">
        @if (!Model.PorPrioridad.Any())
        {
            <partial name="_EstadoVacio" model='("fa-solid fa-flag", "Sin datos.", (string?)null, (string?)null)' />
        }
        else
        {
            @foreach (var fila in Model.PorPrioridad)
            {
                var pct = Model.TotalActivos > 0
                    ? (int)Math.Round((double)fila.Total / Model.TotalActivos * 100)
                    : 0;
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <partial name="_BadgeEstado" model="(fila.Nombre, fila.Color)" />
                        </div>
                        <span class="small text-muted">@fila.Total ticket@(fila.Total != 1 ? "s" : "") — @pct%</span>
                    </div>
                    <div class="progress" style="height:10px; border-radius:6px">
                        <div class="progress-bar" role="progressbar" aria-label="@fila.Nombre"
                             style="width:@pct%; background-color:@fila.Color"
                             aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
