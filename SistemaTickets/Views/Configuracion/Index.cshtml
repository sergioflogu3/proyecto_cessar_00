@model SistemaTickets.Models.Configuracion.ConfiguracionViewModel

@{
    ViewData["Title"] = "Configuración del Sistema";
}

@Html.AntiForgeryToken()

<div class="page-header">
    <h1 class="page-title">Configuración del Sistema</h1>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show py-2 mb-4" role="alert">
        @ok
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 mb-4" role="alert">
        @err
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@* ── Tabs ───────────────────────────────────────────────────────── *@
<ul class="nav nav-tabs mb-4" id="cfgTabs" aria-label="Secciones de configuración">
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "categorias"  ? "active" : "")" aria-current="@(Model.TabActiva == "categorias" ? "page" : null)"
           href="@Url.Action("Index", "Configuracion", new { tab = "categorias" })">
            Categorías
            <span class="badge bg-secondary ms-1">@Model.Categorias.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "prioridades" ? "active" : "")" aria-current="@(Model.TabActiva == "prioridades" ? "page" : null)"
           href="@Url.Action("Index", "Configuracion", new { tab = "prioridades" })">
            Prioridades
            <span class="badge bg-secondary ms-1">@Model.Prioridades.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "estados"     ? "active" : "")" aria-current="@(Model.TabActiva == "estados" ? "page" : null)"
           href="@Url.Action("Index", "Configuracion", new { tab = "estados" })">
            Estados
            <span class="badge bg-secondary ms-1">@Model.Estados.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "activotipos" ? "active" : "")" aria-current="@(Model.TabActiva == "activotipos" ? "page" : null)"
           href="@Url.Action("Index", "Configuracion", new { tab = "activotipos" })">
            Tipos de Activo
            <span class="badge bg-secondary ms-1">@Model.ActivoTipos.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "sedes"       ? "active" : "")" aria-current="@(Model.TabActiva == "sedes" ? "page" : null)"
           href="@Url.Action("Index", "Configuracion", new { tab = "sedes" })">
            Sedes
            <span class="badge bg-secondary ms-1">@Model.Sedes.Count</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "areas"       ? "active" : "")" aria-current="@(Model.TabActiva == "areas" ? "page" : null)"
           href="@Url.Action("Index", "Configuracion", new { tab = "areas" })">
            Áreas
            <span class="badge bg-secondary ms-1">@Model.Areas.Count</span>
        </a>
    </li>
</ul>

@* ═══════════════════════════════════════════════════════════════════
   TAB: CATEGORÍAS
   ══════════════════════════════════════════════════════════════════ *@
@if (Model.TabActiva == "categorias")
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Categorías existentes</span>
                    <span class="text-muted small ms-2">
                        (@Model.Categorias.Count(c => c.Activo) activas,
                         @Model.Categorias.Count(c => !c.Activo) inactivas)
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                    <table class="table table-hover mb-0 tabla-apilable">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Nombre</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th class="text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Categorias.Any())
                            {
                                <tr>
                                    <td colspan="4" class="fila-vacia p-0">
                                        <partial name="_EstadoVacio" model='("fa-solid fa-tags", "No hay categorías registradas.", (string?)null, (string?)null)' />
                                    </td>
                                </tr>
                            }
                            @foreach (var c in Model.Categorias)
                            {
                                <tr class="@(!c.Activo ? "fila-inactiva" : "")">
                                    <td data-label="Nombre" class="px-4 fw-semibold">@c.Nombre</td>
                                    <td data-label="Descripción" class="text-muted small">@(c.Descripcion ?? "—")</td>
                                    <td data-label="Estado">
                                        @if (c.Activo)
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactiva</span>
                                        }
                                    </td>
                                    <td class="text-end px-4 celda-acciones">
                                        <button type="button" class="btn btn-outline-primary btn-sm" title="Editar" aria-label="Editar"
                                                onclick="abrirEditCat(@c.Id, '@Html.Raw(c.Nombre.Replace("'","\\\'"))', '@Html.Raw((c.Descripcion ?? "").Replace("'","\\\'"  ))')">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </button>
                                        <form asp-action="ToggleCategoria" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn btn-sm @(c.Activo ? "btn-outline-secondary" : "btn-outline-success")"
                                                    title="@(c.Activo ? "Desactivar" : "Activar")" aria-label="@(c.Activo ? "Desactivar" : "Activar")">
                                                <i class="fa-solid @(c.Activo ? "fa-ban" : "fa-circle-check")" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Nueva Categoría</span>
                </div>
                <div class="card-body">
                    <form asp-action="CrearCategoria" method="post" data-validar>
                        <div class="mb-3">
                            <label for="altaCatNombre" class="form-label fw-semibold small">Nombre *</label>
                            <input type="text" name="nombre" class="form-control form-control-sm"
                                   placeholder="Ej: REDES" maxlength="100" required id="altaCatNombre"
                                   data-msg-required="El nombre es obligatorio."/>
                        </div>
                        <div class="mb-3">
                            <label for="altaCatDescripcion" class="form-label fw-semibold small">Descripción</label>
                            <input type="text" name="descripcion" class="form-control form-control-sm"
                                   placeholder="Descripción breve (opcional)" maxlength="200" id="altaCatDescripcion"/>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            Crear Categoría
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Modal editar categoría *@
    <div class="modal fade" id="modalEditCat" tabindex="-1" aria-labelledby="modalEditCatTitulo">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:440px">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold" id="modalEditCatTitulo">Editar Categoría</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="EditarCategoria" method="post" data-validar>
                    <div class="modal-body pt-3">
                        <input type="hidden" name="id" id="editCatId" />
                        <div class="mb-3">
                            <label for="editCatNombre" class="form-label fw-semibold small">Nombre *</label>
                            <input type="text" name="nombre" id="editCatNombre"
                                   class="form-control form-control-sm" maxlength="100" required
                                   data-msg-required="El nombre es obligatorio."/>
                        </div>
                        <div class="mb-2">
                            <label for="editCatDesc" class="form-label fw-semibold small">Descripción</label>
                            <input type="text" name="descripcion" id="editCatDesc"
                                   class="form-control form-control-sm" maxlength="200" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════════
   TAB: PRIORIDADES
   ══════════════════════════════════════════════════════════════════ *@
@if (Model.TabActiva == "prioridades")
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Prioridades existentes</span>
                    <span class="text-muted small ms-2">
                        (@Model.Prioridades.Count(p => p.Activo) activas,
                         @Model.Prioridades.Count(p => !p.Activo) inactivas)
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                    <table class="table table-hover mb-0 tabla-apilable">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Color</th>
                                <th>Nombre</th>
                                <th>Orden</th>
                                <th>Estado</th>
                                <th class="text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Prioridades.Any())
                            {
                                <tr>
                                    <td colspan="5" class="fila-vacia p-0">
                                        <partial name="_EstadoVacio" model='("fa-solid fa-flag", "No hay prioridades registradas.", (string?)null, (string?)null)' />
                                    </td>
                                </tr>
                            }
                            @foreach (var p in Model.Prioridades)
                            {
                                <tr class="@(!p.Activo ? "fila-inactiva" : "")">
                                    <td data-label="Color" class="px-4">
                                        <span class="d-inline-block rounded-circle border"
                                              aria-hidden="true" style="width:20px;height:20px;background:@p.Color"></span>
                                    </td>
                                    <td data-label="Nombre" class="fw-semibold">
                                        <partial name="_BadgeEstado" model="(p.Nombre, p.Color)" />
                                    </td>
                                    <td data-label="Orden" class="text-muted small">@p.Orden</td>
                                    <td data-label="Estado">
                                        @if (p.Activo)
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactiva</span>
                                        }
                                    </td>
                                    <td class="text-end px-4 celda-acciones">
                                        <button type="button" class="btn btn-outline-primary btn-sm" title="Editar" aria-label="Editar"
                                                onclick="abrirEditPri(@p.Id, '@Html.Raw(p.Nombre.Replace("'","\\\'"))', '@p.Color', @p.Orden, '@Html.Raw((p.Descripcion ?? "").Replace("'","\\\'"  ))')">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </button>
                                        <form asp-action="TogglePrioridad" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm @(p.Activo ? "btn-outline-secondary" : "btn-outline-success")"
                                                    title="@(p.Activo ? "Desactivar" : "Activar")" aria-label="@(p.Activo ? "Desactivar" : "Activar")">
                                                <i class="fa-solid @(p.Activo ? "fa-ban" : "fa-circle-check")" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Nueva Prioridad</span>
                </div>
                <div class="card-body">
                    <form asp-action="CrearPrioridad" method="post" data-validar>
                        <div class="mb-3">
                            <label for="altaPriNombre" class="form-label fw-semibold small">Nombre *</label>
                            <input type="text" name="nombre" class="form-control form-control-sm"
                                   placeholder="Ej: Urgente" maxlength="50" required id="altaPriNombre"
                                   data-msg-required="El nombre es obligatorio."/>
                        </div>
                        <div class="mb-3">
                            <label for="altaPriColor" class="form-label fw-semibold small">Color</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" name="color" class="form-control form-control-color form-control-sm"
                                       value="#6c757d" style="width:44px;height:32px;padding:2px" id="altaPriColor"/>
                                <span class="text-muted small">Selecciona el color del badge</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="altaPriOrden" class="form-label fw-semibold small">Orden</label>
                            <input type="number" name="orden" id="altaPriOrden" class="form-control form-control-sm"
                                   value="@(Model.Prioridades.Any() ? Model.Prioridades.Max(p => p.Orden) + 1 : 1)"
                                   min="1" />
                        </div>
                        <div class="mb-3">
                            <label for="altaPriDescripcion" class="form-label fw-semibold small">Descripción</label>
                            <input type="text" name="descripcion" class="form-control form-control-sm"
                                   placeholder="Descripción breve (opcional)" maxlength="200" id="altaPriDescripcion"/>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            Crear Prioridad
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Modal editar prioridad *@
    <div class="modal fade" id="modalEditPri" tabindex="-1" aria-labelledby="modalEditPriTitulo">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:440px">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold" id="modalEditPriTitulo">Editar Prioridad</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="EditarPrioridad" method="post" data-validar>
                    <div class="modal-body pt-3">
                        <input type="hidden" name="id" id="editPriId" />
                        <div class="mb-3">
                            <label for="editPriNombre" class="form-label fw-semibold small">Nombre *</label>
                            <input type="text" name="nombre" id="editPriNombre"
                                   class="form-control form-control-sm" maxlength="50" required
                                   data-msg-required="El nombre es obligatorio."/>
                        </div>
                        <div class="mb-3">
                            <label for="editPriColor" class="form-label fw-semibold small">Color</label>
                            <input type="color" name="color" id="editPriColor"
                                   class="form-control form-control-color form-control-sm"
                                   style="width:44px;height:32px;padding:2px" />
                        </div>
                        <div class="mb-3">
                            <label for="editPriOrden" class="form-label fw-semibold small">Orden</label>
                            <input type="number" name="orden" id="editPriOrden"
                                   class="form-control form-control-sm" min="1" />
                        </div>
                        <div class="mb-2">
                            <label for="editPriDesc" class="form-label fw-semibold small">Descripción</label>
                            <input type="text" name="descripcion" id="editPriDesc"
                                   class="form-control form-control-sm" maxlength="200" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════════
   TAB: ESTADOS
   ══════════════════════════════════════════════════════════════════ *@
@if (Model.TabActiva == "estados")
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Estados del flujo</span>
                    <span class="text-muted small ms-2">Solo se puede editar color y orden</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                    <table class="table table-hover mb-0 tabla-apilable">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Color</th>
                                <th>Nombre</th>
                                <th>Orden</th>
                                <th>Estado</th>
                                <th class="text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Estados.Any())
                            {
                                <tr>
                                    <td colspan="5" class="fila-vacia p-0">
                                        <partial name="_EstadoVacio" model='("fa-solid fa-list-check", "No hay estados registrados.", (string?)null, (string?)null)' />
                                    </td>
                                </tr>
                            }
                            @foreach (var e in Model.Estados)
                            {
                                <tr>
                                    <td data-label="Color" class="px-4">
                                        <span class="d-inline-block rounded-circle border"
                                              aria-hidden="true" style="width:20px;height:20px;background:@e.Color"></span>
                                    </td>
                                    <td data-label="Nombre" class="fw-semibold">
                                        <partial name="_BadgeEstado" model="(e.Nombre, e.Color)" />
                                    </td>
                                    <td data-label="Orden" class="text-muted small">@e.Orden</td>
                                    <td data-label="Estado">
                                        @if (e.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end px-4 celda-acciones">
                                        <button type="button" class="btn btn-outline-primary btn-sm" title="Editar" aria-label="Editar"
                                                onclick="abrirEditEst(@e.Id, '@e.Color', @e.Orden)">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-4 text-center text-muted small">
                    <i class="fa-solid fa-circle-info fs-4 d-block mb-2"></i>
                    Los estados controlan el flujo de trabajo del sistema.<br>
                    No se pueden agregar ni eliminar para mantener la integridad del sistema.
                    Solo es posible ajustar el color y el orden de visualización.
                </div>
            </div>
        </div>
    </div>

    @* Modal editar estado *@
    <div class="modal fade" id="modalEditEst" tabindex="-1" aria-labelledby="modalEditEstTitulo">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:380px">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold" id="modalEditEstTitulo">Editar Estado</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="EditarEstado" method="post" data-validar>
                    <div class="modal-body pt-3">
                        <input type="hidden" name="id" id="editEstId" />
                        <div class="mb-3">
                            <label for="editEstColor" class="form-label fw-semibold small">Color del badge</label>
                            <input type="color" name="color" id="editEstColor"
                                   class="form-control form-control-color form-control-sm"
                                   style="width:44px;height:32px;padding:2px" />
                        </div>
                        <div class="mb-2">
                            <label for="editEstOrden" class="form-label fw-semibold small">Orden</label>
                            <input type="number" name="orden" id="editEstOrden"
                                   class="form-control form-control-sm" min="1" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════════
   TAB: TIPOS DE ACTIVO
   ══════════════════════════════════════════════════════════════════ *@
@if (Model.TabActiva == "activotipos")
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Tipos de Activo existentes</span>
                    <span class="text-muted small ms-2">
                        (@Model.ActivoTipos.Count(t => t.Activo) activos,
                         @Model.ActivoTipos.Count(t => !t.Activo) inactivos)
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                    <table class="table table-hover mb-0 tabla-apilable">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Nombre</th>
                                <th>Estado</th>
                                <th class="text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ActivoTipos.Any())
                            {
                                <tr>
                                    <td colspan="3" class="fila-vacia p-0">
                                        <partial name="_EstadoVacio" model='("fa-solid fa-laptop", "No hay tipos de activo registrados.", (string?)null, (string?)null)' />
                                    </td>
                                </tr>
                            }
                            @foreach (var t in Model.ActivoTipos)
                            {
                                <tr class="@(!t.Activo ? "fila-inactiva" : "")">
                                    <td data-label="Nombre" class="px-4 fw-semibold">@t.Nombre</td>
                                    <td data-label="Estado">
                                        @if (t.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
