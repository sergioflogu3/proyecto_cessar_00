@section Scripts {
<script>
    function abrirEditCat(id, nombre, descripcion) {
        document.getElementById('editCatId').value     = id;
        document.getElementById('editCatNombre').value = nombre;
        document.getElementById('editCatDesc').value   = descripcion;
        new bootstrap.Modal(document.getElementById('modalEditCat')).show();
    }

    function abrirEditPri(id, nombre, color, orden, descripcion) {
        document.getElementById('editPriId').value     = id;
        document.getElementById('editPriNombre').value = nombre;
        document.getElementById('editPriColor').value  = color;
        document.getElementById('editPriOrden').value  = orden;
        document.getElementById('editPriDesc').value   = descripcion;
        new bootstrap.Modal(document.getElementById('modalEditPri')).show();
    }

    function abrirEditEst(id, color, orden) {
        document.getElementById('editEstId').value    = id;
        document.getElementById('editEstColor').value = color;
        document.getElementById('editEstOrden').value = orden;
        new bootstrap.Modal(document.getElementById('modalEditEst')).show();
    }

    function abrirEditTipo(id, nombre) {
        document.getElementById('editTipoId').value     = id;
        document.getElementById('editTipoNombre').value = nombre;
        new bootstrap.Modal(document.getElementById('modalEditTipo')).show();
    }

    function abrirEditSede(id, nombre, ciudad, direccion) {
        document.getElementById('editSedeId').value        = id;
        document.getElementById('editSedeNombre').value    = nombre;
        document.getElementById('editSedeCiudad').value    = ciudad;
        document.getElementById('editSedeDireccion').value = direccion;
        new bootstrap.Modal(document.getElementById('modalEditSede')).show();
    }

    function abrirEditArea(id, nombre, sedeId) {
        document.getElementById('editAreaId').value     = id;
        document.getElementById('editAreaNombre').value = nombre;
        document.getElementById('editAreaSedeId').value = sedeId;
        new bootstrap.Modal(document.getElementById('modalEditArea')).show();
    }
</script>
}
