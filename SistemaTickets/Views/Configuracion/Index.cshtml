@if (Model.TabActiva == "sedes")
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Sedes existentes</span>
                    <span class="text-muted small ms-2">
                        (@Model.Sedes.Count(s => s.Activa) activas,
                         @Model.Sedes.Count(s => !s.Activa) inactivas)
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                    <table class="table table-hover mb-0 tabla-apilable">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Nombre</th>
                                <th>Ciudad</th>
                                <th>Dirección</th>
                                <th>Estado</th>
                                <th class="text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Sedes.Any())
                            {
                                <tr>
                                    <td colspan="5" class="fila-vacia p-0">
                                        <partial name="_EstadoVacio" model='("fa-solid fa-building", "No hay sedes registradas.", (string?)null, (string?)null)' />
                                    </td>
                                </tr>
                            }
                            @foreach (var s in Model.Sedes)
                            {
                                <tr class="@(!s.Activa ? "fila-inactiva" : "")">
                                    <td data-label="Nombre" class="px-4 fw-semibold">@s.Nombre</td>
                                    <td data-label="Ciudad" class="text-muted small">@s.Ciudad</td>
                                    <td data-label="Dirección" class="text-muted small">@(s.Direccion ?? "—")</td>
                                    <td data-label="Estado">
                                        @if (s.Activa)
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactiva</span>
                                        }
                                    </td>
                                    <td class="text-end px-4 celda-acciones">
                                        <button type="button" class="btn btn-outline-primary btn-sm" title="Editar" aria-label="Editar"
                                                onclick="abrirEditSede(@s.Id, '@Html.Raw(s.Nombre.Replace("'","\\\'"))', '@Html.Raw(s.Ciudad.Replace("'","\\\'"))', '@Html.Raw((s.Direccion ?? "").Replace("'","\\\'"))')">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </button>
                                        <form asp-action="ToggleSede" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm @(s.Activa ? "btn-outline-secondary" : "btn-outline-success")"
                                                    title="@(s.Activa ? "Desactivar" : "Activar")" aria-label="@(s.Activa ? "Desactivar" : "Activar")">
                                                <i class="fa-solid @(s.Activa ? "fa-ban" : "fa-circle-check")" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Nueva Sede</span>
                </div>
                <div class="card-body">
                    <form asp-action="CrearSede" method="post" data-validar>
                        <div class="mb-3">
                            <label for="altaSedeNombre" class="form-label fw-semibold small">Nombre *</label>
                            <input type="text" name="nombre" class="form-control form-control-sm"
                                   placeholder="Ej: Sede Central" maxlength="100" required id="altaSedeNombre"
                                   data-msg-required="El nombre es obligatorio."/>
                        </div>
                        <div class="mb-3">
                            <label for="altaSedeCiudad" class="form-label fw-semibold small">Ciudad *</label>
                            <input type="text" name="ciudad" class="form-control form-control-sm"
                                   placeholder="Ej: Lima" maxlength="100" required id="altaSedeCiudad"
                                   data-msg-required="La ciudad es obligatoria."/>
                        </div>
                        <div class="mb-3">
                            <label for="altaSedeDireccion" class="form-label fw-semibold small">Dirección</label>
                            <input type="text" name="direccion" class="form-control form-control-sm"
                                   placeholder="Dirección (opcional)" maxlength="200" id="altaSedeDireccion"/>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            Crear Sede
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditSede" tabindex="-1" aria-labelledby="modalEditSedeTitulo">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:460px">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold" id="modalEditSedeTitulo">Editar Sede</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="EditarSede" method="post" data-validar>
                    <div class="modal-body pt-3">
                        <input type="hidden" name="id" id="editSedeId" />
                        <div class="mb-3">
                            <label for="editSedeNombre" class="form-label fw-semibold small">Nombre *</label>
                            <input type="text" name="nombre" id="editSedeNombre"
                                   class="form-control form-control-sm" maxlength="100" required
                                   data-msg-required="El nombre es obligatorio."/>
                        </div>
                        <div class="mb-3">
                            <label for="editSedeCiudad" class="form-label fw-semibold small">Ciudad *</label>
                            <input type="text" name="ciudad" id="editSedeCiudad"
                                   class="form-control form-control-sm" maxlength="100" required
                                   data-msg-required="La ciudad es obligatoria."/>
                        </div>
                        <div class="mb-2">
                            <label for="editSedeDireccion" class="form-label fw-semibold small">Dirección</label>
                            <input type="text" name="direccion" id="editSedeDireccion"
                                   class="form-control form-control-sm" maxlength="200" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

