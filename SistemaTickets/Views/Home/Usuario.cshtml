@{
    ViewData["Title"] = "Mis Tickets";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Portal de Usuario</h2>
            <small class="text-muted">Bienvenido, @ViewBag.UserName</small>
        </div>
        <span class="badge bg-secondary fs-6">Usuario</span>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3">➕</div>
                    <h5 class="card-title">Crear Ticket</h5>
                    <p class="card-text text-muted small">Reportar una nueva incidencia o solicitud de soporte.</p>
                    <a asp-controller="Tickets" asp-action="Create" class="btn btn-secondary btn-sm mt-2">Crear ticket</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3">📋</div>
                    <h5 class="card-title">Mis Tickets</h5>
                    <p class="card-text text-muted small">Ver el estado y seguimiento de tus solicitudes.</p>
                    <a asp-controller="Tickets" asp-action="Index" class="btn btn-secondary btn-sm mt-2">Ver mis tickets</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3">🕐</div>
                    <h5 class="card-title">Historial</h5>
                    <p class="card-text text-muted small">Consultar tickets anteriores ya cerrados.</p>
                    <a asp-controller="Tickets" asp-action="Index" asp-route-estadoId="6" class="btn btn-secondary btn-sm mt-2">Ver historial</a>
                </div>
            </div>
        </div>

    </div>
</div>
