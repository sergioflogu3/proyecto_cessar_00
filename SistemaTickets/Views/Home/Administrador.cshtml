@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container-fluid mt-4">

    <div class="page-header">
        <div>
            <h1 class="page-title">Panel de Administración</h1>
            <small class="page-subtitle">Bienvenido, @ViewBag.UserName</small>
        </div>
        <div class="page-actions">
            <span class="badge bg-success fs-6">Administrador</span>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3" aria-hidden="true"><i class="fa-solid fa-users"></i></div>
                    <h2 class="card-title h5">Gestión de Usuarios</h2>
                    <p class="card-text text-muted small">Crear, editar y desactivar cuentas de usuario.</p>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-success btn-sm mt-2">Gestionar</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3" aria-hidden="true"><i class="fa-solid fa-ticket"></i></div>
                    <h2 class="card-title h5">Todos los Tickets</h2>
                    <p class="card-text text-muted small">Visualizar y gestionar todos los tickets del sistema.</p>
                    <a asp-controller="Tickets" asp-action="Index" class="btn btn-success btn-sm mt-2">Ver tickets</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3" aria-hidden="true"><i class="fa-solid fa-chart-bar"></i></div>
                    <h2 class="card-title h5">Dashboard</h2>
                    <p class="card-text text-muted small">Métricas de tickets, tiempos y desempeño del equipo.</p>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-success btn-sm mt-2">Ver dashboard</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3" aria-hidden="true"><i class="fa-solid fa-arrow-trend-up"></i></div>
                    <h2 class="card-title h5">Seguimiento</h2>
                    <p class="card-text text-muted small">Estado general de tickets por técnico y prioridad.</p>
                    <a asp-controller="Supervisor" asp-action="Seguimiento" class="btn btn-success btn-sm mt-2">Ver seguimiento</a>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mt-2">

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3" aria-hidden="true"><i class="fa-solid fa-box"></i></div>
                    <h2 class="card-title h5">Inventario Técnico</h2>
                    <p class="card-text text-muted small">Herramientas, activos y asignaciones del equipo de soporte.</p>
                    <a asp-controller="Inventario" asp-action="Activos" class="btn btn-success btn-sm mt-2">Ver inventario</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3" aria-hidden="true"><i class="fa-solid fa-screwdriver-wrench"></i></div>
                    <h2 class="card-title h5">Visitas y Repuestos</h2>
                    <p class="card-text text-muted small">Visitas técnicas, repuestos y control de stock por sede.</p>
                    <a asp-controller="Campo" asp-action="Visitas" class="btn btn-success btn-sm mt-2">Ver campo</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3" aria-hidden="true"><i class="fa-solid fa-sliders"></i></div>
                    <h2 class="card-title h5">Configuración</h2>
                    <p class="card-text text-muted small">Categorías, prioridades y estados del sistema de tickets.</p>
                    <a asp-controller="Configuracion" asp-action="Index" class="btn btn-success btn-sm mt-2">Configurar</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-4">
                    <div class="display-6 mb-3" aria-hidden="true"><i class="fa-solid fa-file-excel"></i></div>
                    <h2 class="card-title h5">Reportes Excel</h2>
                    <p class="card-text text-muted small">Genera reportes de tickets, técnicos, historial y usuarios exportables a Excel.</p>
                    <a asp-controller="Reportes" asp-action="Index" class="btn btn-success btn-sm mt-2">Ver reportes</a>
                </div>
            </div>
        </div>

    </div>
</div>
