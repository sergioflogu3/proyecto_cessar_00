@model SistemaTickets.Models.Inventario.ActivoIndexViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Activos de TI";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var esAdmin = role == "Administrador";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Activos de TI</h4>
        <small class="text-muted">
            Mostrando @Model.DesdeRegistro–@Model.HastaRegistro de @Model.TotalRegistros activos
        </small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Herramientas" class="btn btn-outline-primary btn-sm">Ver Herramientas</a>
        @if (esAdmin)
        {
            <a asp-action="ActivoCreate" class="btn btn-primary btn-sm px-3">+ Nuevo Activo</a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Activos" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Buscar</label>
                <input type="text" name="search" value="@Model.Search"
                       class="form-control form-control-sm" placeholder="Nombre, serie o marca..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Tipo</label>
                <select name="tipo" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var t in Model.TiposActivo)
                    {
                        <option value="@t.Nombre" selected="@(Model.FiltroTipo == t.Nombre)">@t.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Estado</label>
                <select name="estado" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var e in SistemaTickets.Models.Inventario.ActivoIndexViewModel.Estados)
                    {
                        <option value="@e" selected="@(Model.FiltroEstado == e)">@e</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Buscar</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Activos" class="btn btn-outline-secondary btn-sm w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width:50px">#</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Marca / Modelo</th>
                        <th>Serie</th>
                        <th>Estado</th>
                        <th>Asignado a</th>
                        <th>Sede</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Activos.Any())
                    {
                        <tr><td colspan="9" class="text-center py-5 text-muted">No se encontraron activos.</td></tr>
                    }
                    else
                    {
                        var num = Model.DesdeRegistro;
                        @foreach (var a in Model.Activos)
                        {
                            var estadoColor = a.Estado switch
                            {
                                "Disponible"      => "success",
                                "Asignado"        => "primary",
                                "En Mantenimiento"=> "warning",
                                "Baja"            => "danger",
                                _                 => "secondary"
                            };
                            <tr>
                                <td class="ps-4 text-muted small">@num</td>
                                <td>
                                    <a asp-action="ActivoDetails" asp-route-id="@a.Id"
                                       class="fw-semibold text-decoration-none text-dark">@a.Nombre</a>
                                </td>
                                <td><span class="badge bg-secondary">@a.Tipo</span></td>
                                <td class="small text-muted">@(a.Marca ?? "—") @(a.Modelo != null ? "/ " + a.Modelo : "")</td>
                                <td class="small text-muted">@(a.NumeroSerie ?? "—")</td>
                                <td><span class="badge bg-@estadoColor">@a.Estado</span></td>
                                <td class="small text-muted">
                                    @(a.AsignadoA is null ? "—" : a.AsignadoA.NombreCompleto)
                                </td>
                                <td class="small text-muted">@(a.Sede?.Nombre ?? "—")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="ActivoDetails" asp-route-id="@a.Id"
                                       class="btn btn-outline-primary btn-sm">Ver</a>
                                    @if (esAdmin)
                                    {
                                        <a asp-action="ActivoEdit" asp-route-id="@a.Id"
                                           class="btn btn-outline-secondary btn-sm ms-1">Editar</a>
                                        @if (a.Estado != "Baja")
                                        {
                                            <button class="btn btn-outline-danger btn-sm ms-1"
                                                    onclick="confirmarBaja(@a.Id, '@a.Nombre')">
                                                Dar de baja
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                            num++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPaginas > 1)
{
    <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" href="?page=@(Model.PaginaActual-1)&search=@Model.Search&tipo=@Model.FiltroTipo&estado=@Model.FiltroEstado">‹</a>
            </li>
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" href="?page=@i&search=@Model.Search&tipo=@Model.FiltroTipo&estado=@Model.FiltroEstado">@i</a>
                </li>
            }
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" href="?page=@(Model.PaginaActual+1)&search=@Model.Search&tipo=@Model.FiltroTipo&estado=@Model.FiltroEstado">›</a>
            </li>
        </ul>
    </nav>
}

@* Modal baja *@
<div class="modal fade" id="bajaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">Dar de baja activo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="mb-1">¿Confirma dar de baja:</p>
                <p class="fw-bold" id="bajaNombre"></p>
                <p class="text-muted small mb-0">El activo quedará marcado como Baja y no aparecerá en el inventario activo.</p>
            </div>
            <div class="modal-footer border-0 pt-0 gap-2">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger px-4" id="bajaBtn">Confirmar baja</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;
    let _bajaId = null;

    function confirmarBaja(id, nombre) {
        _bajaId = id;
        document.getElementById('bajaNombre').textContent = nombre;
        new bootstrap.Modal(document.getElementById('bajaModal')).show();
    }

    document.getElementById('bajaBtn').addEventListener('click', async () => {
        bootstrap.Modal.getInstance(document.getElementById('bajaModal')).hide();
        const fd = new FormData();
        fd.append('id', _bajaId);
        fd.append('__RequestVerificationToken', csrf);
        const res = await fetch('/Inventario/ActivoBaja', { method: 'POST', body: fd });
        const r   = await res.json();
        r.success ? window.location.reload() : alert(r.message ?? 'Error');
    });
</script>
}
