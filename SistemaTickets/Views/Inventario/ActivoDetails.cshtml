@model SistemaTickets.Domain.Entities.Activo
@using System.Security.Claims

@{
    ViewData["Title"] = $"Activo #{Model.Id}";
    var role    = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var esAdmin = role == "Administrador";
    var esAdminOSupervisor = role is "Administrador" or "Supervisor";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Activos" class="btn btn-outline-secondary btn-sm">← Activos</a>
            <span class="text-muted small">Activo #@Model.Id</span>
        </div>
        <h4 class="mb-1 fw-bold">@Model.Nombre</h4>
        <div class="d-flex gap-2 flex-wrap">
            <span class="badge bg-secondary">@Model.Tipo</span>
            @{
                var estadoColor = Model.Estado switch
                {
                    "Disponible"       => "success",
                    "Asignado"         => "primary",
                    "En Mantenimiento" => "warning",
                    "Baja"             => "danger",
                    _                  => "secondary"
                };
            }
            <span class="badge bg-@estadoColor">@Model.Estado</span>
        </div>
    </div>
    @if (esAdmin && Model.Estado != "Baja")
    {
        <div class="d-flex gap-2">
            <a asp-action="ActivoEdit" asp-route-id="@Model.Id"
               class="btn btn-outline-primary btn-sm">Editar</a>
            @if (Model.Estado == "Disponible")
            {
                <button class="btn btn-primary btn-sm" id="btnAsignarActivo">Asignar</button>
            }
        </div>
    }
</div>

<div class="row g-4">

    <div class="col-lg-8">

        @* Movimientos *@
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold">Historial de movimientos</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Movimientos.Any())
                {
                    <div class="text-center text-muted py-4">Sin movimientos registrados.</div>
                }
                else
                {
                    @foreach (var m in Model.Movimientos)
                    {
                        <div class="d-flex align-items-start gap-3 border-bottom px-4 py-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center
                                        justify-content-center flex-shrink-0"
                                 style="width:32px;height:32px;font-size:.7rem">
                                @m.Usuario.Nombre[0]@m.Usuario.Apellido[0]
                            </div>
                            <div>
                                <div class="small fw-semibold">
                                    @m.Usuario.NombreCompleto
                                    <span class="text-muted fw-normal">— @m.TipoMovimiento</span>
                                </div>
                                @if (!string.IsNullOrEmpty(m.Descripcion))
                                {
                                    <div class="small text-muted">@m.Descripcion</div>
                                }
                                @if (!string.IsNullOrEmpty(m.ValorAnterior) || !string.IsNullOrEmpty(m.ValorNuevo))
                                {
                                    <div class="small">
                                        @if (!string.IsNullOrEmpty(m.ValorAnterior))
                                        { <span class="text-danger">@m.ValorAnterior</span><span> → </span> }
                                        @if (!string.IsNullOrEmpty(m.ValorNuevo))
                                        { <span class="text-success">@m.ValorNuevo</span> }
                                    </div>
                                }
                                <div class="text-muted" style="font-size:.75rem">
                                    @m.FechaMovimiento.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold">Información del activo</span>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">Marca</span>
                    <span class="small fw-semibold">@(Model.Marca ?? "—")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">Modelo</span>
                    <span class="small fw-semibold">@(Model.Modelo ?? "—")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">N° Serie</span>
                    <span class="small">@(Model.NumeroSerie ?? "—")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">Sede</span>
                    <span class="small">@(Model.Sede?.Nombre ?? "—")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">Área</span>
                    <span class="small">@(Model.Area?.Nombre ?? "—")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">Asignado a</span>
                    <span class="small">@(Model.AsignadoA?.NombreCompleto ?? "—")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">Adquisición</span>
                    <span class="small">
                        @(Model.FechaAdquisicion.HasValue
                            ? Model.FechaAdquisicion.Value.ToString("dd/MM/yyyy")
                            : "—")
                    </span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">Garantía</span>
                    <span class="small @(Model.FechaGarantia < DateTime.UtcNow ? "text-danger" : "")">
                        @(Model.FechaGarantia.HasValue
                            ? Model.FechaGarantia.Value.ToString("dd/MM/yyyy")
                            : "—")
                    </span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-4 py-2">
                    <span class="text-muted small">Registrado</span>
                    <span class="small">@Model.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy")</span>
                </li>
            </ul>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <span class="fw-semibold">Descripción</span>
                </div>
                <div class="card-body">
                    <p class="mb-0 small" style="white-space:pre-wrap">@Model.Descripcion</p>
                </div>
            </div>
        }
    </div>
</div>

@* Modal asignar activo *@
@if (esAdminOSupervisor)
{
    <div class="modal fade" id="asignarActivoModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Asignar activo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-semibold">Asignar a</label>
                    <select id="selectUsuarioActivo" class="form-select mb-3">
                        <option value="">Cargando...</option>
                    </select>
                    <div id="errorAsignarActivo" class="alert alert-danger py-2 small d-none"></div>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4" id="confirmarAsignarActivo">Asignar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    const csrf    = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const activoId = @Model.Id;

    const btnAsignar = document.getElementById('btnAsignarActivo');
    if (btnAsignar) {
        btnAsignar.addEventListener('click', async () => {
            const select = document.getElementById('selectUsuarioActivo');
            select.innerHTML = '<option value="">Cargando...</option>';
            const res  = await fetch('/Inventario/GetTecnicos');
            const data = await res.json();
            select.innerHTML = '<option value="">Selecciona usuario...</option>';
            data.forEach(u => {
                const o = document.createElement('option');
                o.value = u.id; o.text = u.nombre;
                select.appendChild(o);
            });
            new bootstrap.Modal(document.getElementById('asignarActivoModal')).show();
        });

        document.getElementById('confirmarAsignarActivo').addEventListener('click', async () => {
            const usuarioId = document.getElementById('selectUsuarioActivo').value;
            const errBox    = document.getElementById('errorAsignarActivo');
            if (!usuarioId) { errBox.textContent = 'Selecciona un usuario.'; errBox.classList.remove('d-none'); return; }
            errBox.classList.add('d-none');
            const fd = new FormData();
            fd.append('activoId', activoId);
            fd.append('usuarioId', usuarioId);
            fd.append('__RequestVerificationToken', csrf);
            const res = await fetch('/Inventario/AsignarActivo', { method: 'POST', body: fd });
            const r   = await res.json();
            r.success ? window.location.reload() : (errBox.textContent = r.message, errBox.classList.remove('d-none'));
        });
    }
</script>
}
