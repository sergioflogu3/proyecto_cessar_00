@model SistemaTickets.Models.Inventario.ActivoFormViewModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Activo" : "Nuevo Activo";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Activos" class="btn btn-outline-secondary btn-sm">← Volver</a>
    <h4 class="mb-0 fw-bold">@ViewData["Title"]</h4>
</div>

<div class="card border-0 shadow-sm" style="max-width:820px">
    <div class="card-body p-4">
        <form asp-action="@(Model.EsEdicion ? "ActivoEdit" : "ActivoCreate")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre *</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Tipo" class="form-label fw-semibold">Tipo *</label>
                    <select asp-for="Tipo" class="form-select"
                            asp-items="@(new SelectList(Model.TiposActivo, "Nombre", "Nombre"))">
                        <option value="">Selecciona...</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-4">
                    <label asp-for="Marca" class="form-label fw-semibold">Marca</label>
                    <input asp-for="Marca" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Modelo" class="form-label fw-semibold">Modelo</label>
                    <input asp-for="Modelo" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="NumeroSerie" class="form-label fw-semibold">Número de serie</label>
                    <input asp-for="NumeroSerie" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="FechaAdquisicion" class="form-label fw-semibold">Fecha adquisición</label>
                    <input asp-for="FechaAdquisicion" type="date" class="form-control"
                           value="@Model.FechaAdquisicion?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label asp-for="FechaGarantia" class="form-label fw-semibold">Garantía hasta</label>
                    <input asp-for="FechaGarantia" type="date" class="form-control"
                           value="@Model.FechaGarantia?.ToString("yyyy-MM-dd")" />
                </div>
                @if (Model.EsEdicion)
                {
                    <div class="col-md-4">
                        <label asp-for="Estado" class="form-label fw-semibold">Estado</label>
                        <select asp-for="Estado" class="form-select"
                                asp-items="@(new SelectList(SistemaTickets.Models.Inventario.ActivoFormViewModel.Estados))">
                        </select>
                    </div>
                }
                <div class="col-md-4">
                    <label asp-for="SedeId" class="form-label fw-semibold">Sede</label>
                    <select asp-for="SedeId" class="form-select" id="sedeSelect"
                            asp-items="@(new SelectList(Model.Sedes, "Id", "Nombre"))">
                        <option value="">Sin sede</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AreaId" class="form-label fw-semibold">Área</label>
                    <select asp-for="AreaId" class="form-select" id="areaSelect"
                            asp-items="@(new SelectList(Model.Areas, "Id", "Nombre"))">
                        <option value="">Sin área</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AsignadoAId" class="form-label fw-semibold">Asignado a</label>
                    <select asp-for="AsignadoAId" class="form-select"
                            asp-items="@(new SelectList(Model.Usuarios, "Id", "NombreCompleto"))">
                        <option value="">Sin asignar</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary px-4">
                    @(Model.EsEdicion ? "Guardar cambios" : "Registrar activo")
                </button>
                <a asp-action="Activos" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    document.getElementById('sedeSelect').addEventListener('change', async function () {
        const sedeId = this.value;
        const areaSelect = document.getElementById('areaSelect');
        areaSelect.innerHTML = '<option value="">Sin área</option>';
        if (!sedeId) return;
        const res  = await fetch(`/Inventario/GetAreasBySede?sedeId=${sedeId}`);
        const data = await res.json();
        data.forEach(a => {
            const opt = document.createElement('option');
            opt.value = a.id;
            opt.text  = a.nombre;
            areaSelect.appendChild(opt);
        });
    });
</script>
}
