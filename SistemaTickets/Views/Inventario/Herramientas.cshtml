@model SistemaTickets.Models.Inventario.HerramientaIndexViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Herramientas";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var esAdminOSupervisor = role is "Administrador" or "Supervisor";
    var esSoporte = role == "Soporte";
}

@Html.AntiForgeryToken()

<div class="page-header">
    <div>
        <h1 class="page-title">@(esSoporte ? "Mis Herramientas Asignadas" : "Herramientas")</h1>
        <small class="page-subtitle">
            @if (!esSoporte)
            {
                <span>Mostrando @Model.DesdeRegistro–@Model.HastaRegistro de @Model.TotalRegistros herramientas</span>
            }
        </small>
    </div>
    <div class="page-actions">
        @if (esAdminOSupervisor)
        {
            <a asp-action="Activos" class="btn btn-outline-primary btn-sm">Ver Activos</a>
            <a asp-action="HerramientaCreate" class="btn btn-primary btn-sm px-3">+ Nueva Herramienta</a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (esAdminOSupervisor)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" asp-action="Herramientas" class="row g-2 align-items-end">
                <div class="col-12 col-md-6 col-lg-5">
                    <label for="filtroSearch" class="form-label small text-muted mb-1">Buscar</label>
                    <input type="text" id="filtroSearch" name="search" value="@Model.Search"
                           class="form-control form-control-sm" placeholder="Nombre o código..." />
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <label for="filtroTipo" class="form-label small text-muted mb-1">Tipo</label>
                    <select id="filtroTipo" name="tipo" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        @foreach (var t in SistemaTickets.Models.Inventario.HerramientaIndexViewModel.Tipos)
                        {
                            <option value="@t" selected="@(Model.FiltroTipo == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <label for="filtroEstado" class="form-label small text-muted mb-1">Estado</label>
                    <select id="filtroEstado" name="estado" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        @foreach (var e in SistemaTickets.Models.Inventario.HerramientaIndexViewModel.Estados)
                        {
                            <option value="@e" selected="@(Model.FiltroEstado == e)">@e</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3 acciones-form d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Buscar</button>
                    <a asp-action="Herramientas" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros" aria-label="Limpiar filtros">✕</a>
                </div>
            </form>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 tabla-apilable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width:50px">#</th>
                        <th>Nombre</th>
                        <th>Código</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        @if (esAdminOSupervisor)
                        {
                            <th>Asignada a</th>
                        }
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Herramientas.Any())
                    {
                        <tr>
                            <td colspan="7" class="fila-vacia p-0">
                                <partial name="_EstadoVacio" model='("fa-solid fa-screwdriver-wrench", esSoporte ? "No tienes herramientas asignadas." : "No se encontraron herramientas.", (string?)null, (string?)null)' />
                            </td>
                        </tr>
                    }
                    else
                    {
                        var num = Model.DesdeRegistro;
                        @foreach (var h in Model.Herramientas)
                        {
                            var estadoColor = h.Estado switch
                            {
                                "Disponible"   => "success",
                                "Asignada"     => "primary",
                                "En Reparación"=> "warning text-dark",
                                "Baja"         => "danger",
                                _              => "secondary"
                            };
                            var asignacionActual = h.Asignaciones.FirstOrDefault(a => a.Activa);
                            <tr>
                                <td data-label="#" class="ps-4 text-muted small">@num</td>
                                <td data-label="Nombre">
                                    <a asp-action="HerramientaDetails" asp-route-id="@h.Id"
                                       class="fw-semibold text-decoration-none text-dark">@h.Nombre</a>
                                </td>
                                <td data-label="Código" class="text-muted small">@(h.Codigo ?? "—")</td>
                                <td data-label="Tipo"><span class="badge bg-secondary">@h.Tipo</span></td>
                                <td data-label="Estado"><span class="badge bg-@estadoColor">@h.Estado</span></td>
                                @if (esAdminOSupervisor)
                                {
                                    <td data-label="Asignada a" class="small text-muted">
                                        @(asignacionActual?.Tecnico.NombreCompleto ?? "—")
                                    </td>
                                }
                                <td class="text-end pe-4 celda-acciones">
                                    <a asp-action="HerramientaDetails" asp-route-id="@h.Id"
                                       class="btn btn-outline-primary btn-sm" title="Ver" aria-label="Ver">
               <i class="fa-solid fa-eye" aria-hidden="true"></i>
            </a>
                                    @if (esAdminOSupervisor)
                                    {
                                        <a asp-action="HerramientaEdit" asp-route-id="@h.Id"
                                           class="btn btn-outline-primary btn-sm ms-1" title="Editar" aria-label="Editar">
               <i class="fa-solid fa-pen" aria-hidden="true"></i>
            </a>
                                        @if (h.Estado == "Disponible")
                                        {
                                            <button class="btn btn-outline-success btn-sm ms-1"
                                                    onclick="abrirAsignar(@h.Id)"
                                                    title="Asignar" aria-label="Asignar">
                                                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                                            </button>
                                        }
                                        else if (h.Estado == "Asignada")
                                        {
                                            <button class="btn btn-outline-warning btn-sm ms-1"
                                                    onclick="confirmarDevolver(@h.Id, '@h.Nombre')"
                                                    title="Devolver" aria-label="Devolver">
                                                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                            num++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Paginación *@
@{
    Func<int, string> urlPagina = n => "?page=" + n + "&search=" + Uri.EscapeDataString(Model.Search ?? "");
}
<partial name="_Paginacion" model="(Model.PaginaActual, Model.TotalPaginas, urlPagina)" />

@* Modal asignar herramienta *@
@if (esAdminOSupervisor)
{
    <div class="modal fade" id="asignarModal" tabindex="-1" aria-labelledby="asignarModalTitulo">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="asignarModalTitulo">Asignar herramienta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="asignarHId" />
                    <div class="mb-3">
                        <label for="selectTecnico" class="form-label fw-semibold">Técnico</label>
                        <select id="selectTecnico" class="form-select">
                            <option value="">Cargando...</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label for="txtAsignarObs" class="form-label fw-semibold">Observaciones</label>
                        <textarea id="txtAsignarObs" class="form-control" rows="2"></textarea>
                    </div>
                    <div id="errorAsignar" class="alert alert-danger py-2 small d-none" role="alert"></div>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success px-4" id="confirmarAsignarBtn">Asignar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="devolverModal" tabindex="-1" aria-labelledby="devolverModalTitulo">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:420px">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="devolverModalTitulo">Registrar devolución</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="devolverHId" />
                    <p>Herramienta: <strong id="devolverNombre"></strong></p>
                    <label for="txtDevolverObs" class="form-label fw-semibold">Observaciones</label>
                    <textarea id="txtDevolverObs" class="form-control" rows="2"></textarea>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-warning px-4" id="confirmarDevolverBtn">Confirmar devolución</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    const csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;

    async function cargarTecnicos() {
        const select = document.getElementById('selectTecnico');
        select.innerHTML = '<option value="">Cargando...</option>';
        const res  = await fetch('/Inventario/GetTecnicos');
        const data = await res.json();
        select.innerHTML = '<option value="">Selecciona técnico...</option>';
        data.forEach(u => {
            const o = document.createElement('option');
            o.value = u.id; o.text = u.nombre;
            select.appendChild(o);
        });
    }

    async function abrirAsignar(hId) {
        document.getElementById('asignarHId').value = hId;
        document.getElementById('errorAsignar').classList.add('d-none');
        await cargarTecnicos();
        new bootstrap.Modal(document.getElementById('asignarModal')).show();
    }

    function confirmarDevolver(hId, nombre) {
        document.getElementById('devolverHId').value = hId;
        document.getElementById('devolverNombre').textContent = nombre;
        new bootstrap.Modal(document.getElementById('devolverModal')).show();
    }

    document.getElementById('confirmarAsignarBtn')?.addEventListener('click', async () => {
        const herramientaId = document.getElementById('asignarHId').value;
        const tecnicoId     = document.getElementById('selectTecnico').value;
        const observaciones = document.getElementById('txtAsignarObs').value;
        const errBox        = document.getElementById('errorAsignar');
        if (!tecnicoId) { errBox.textContent = 'Selecciona un técnico.'; errBox.classList.remove('d-none'); return; }
        errBox.classList.add('d-none');
        const fd = new FormData();
        fd.append('herramientaId', herramientaId);
        fd.append('tecnicoId', tecnicoId);
        fd.append('observaciones', observaciones);
        fd.append('__RequestVerificationToken', csrf);
        const res = await fetch('/Inventario/AsignarHerramienta', { method: 'POST', body: fd });
        const r   = await res.json();
        r.success ? window.location.reload() : (errBox.textContent = r.message, errBox.classList.remove('d-none'));
    });

    document.getElementById('confirmarDevolverBtn')?.addEventListener('click', async () => {
        const herramientaId = document.getElementById('devolverHId').value;
        const observaciones = document.getElementById('txtDevolverObs').value;
        bootstrap.Modal.getInstance(document.getElementById('devolverModal')).hide();
        const fd = new FormData();
        fd.append('herramientaId', herramientaId);
        fd.append('observaciones', observaciones);
        fd.append('__RequestVerificationToken', csrf);
        const res = await fetch('/Inventario/DevolverHerramienta', { method: 'POST', body: fd });
        const r   = await res.json();
        r.success ? window.location.reload() : alert(r.message ?? 'Error');
    });
</script>
}
