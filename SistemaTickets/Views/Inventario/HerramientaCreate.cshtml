@model SistemaTickets.Models.Inventario.HerramientaFormViewModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Herramienta" : "Nueva Herramienta";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Herramientas" class="btn btn-outline-secondary btn-sm">← Volver</a>
    <h4 class="mb-0 fw-bold">@ViewData["Title"]</h4>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px">
    <div class="card-body p-4">
        <form asp-action="@(Model.EsEdicion ? "HerramientaEdit" : "HerramientaCreate")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold">Nombre *</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Codigo" class="form-label fw-semibold">Código</label>
                    <input asp-for="Codigo" class="form-control" placeholder="Ej: HRR-006" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Tipo" class="form-label fw-semibold">Tipo *</label>
                    <select asp-for="Tipo" class="form-select"
                            asp-items="@(new SelectList(SistemaTickets.Models.Inventario.HerramientaFormViewModel.Tipos))">
                        <option value="">Selecciona...</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    @(Model.EsEdicion ? "Guardar cambios" : "Registrar herramienta")
                </button>
                <a asp-action="Herramientas" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
