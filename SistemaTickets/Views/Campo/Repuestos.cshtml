@model SistemaTickets.Models.Campo.RepuestoIndexViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Repuestos";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var esAdminOSupervisor = role is "Administrador" or "Supervisor";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Repuestos</h1>
        <small class="page-subtitle">
            Mostrando @Model.DesdeRegistro–@Model.HastaRegistro de @Model.TotalRegistros repuestos
        </small>
    </div>
    <div class="page-actions">
        <a asp-action="Visitas" class="btn btn-outline-primary btn-sm">Ver Visitas</a>
        @if (esAdminOSupervisor)
        {
            <a asp-action="RepuestoCreate" class="btn btn-primary btn-sm px-3">+ Nuevo Repuesto</a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model.StockAlerta.Any())
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 mb-4" role="status">
        <span class="fw-semibold">⚠ Stock bajo mínimo:</span>
        @foreach (var s in Model.StockAlerta)
        {
            <span class="badge bg-warning text-dark">@s.Repuesto.Nombre (@s.CantidadActual/@s.CantidadMinima)</span>
        }
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Repuestos" class="row g-2 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label for="filtroSearch" class="form-label small text-muted mb-1">Buscar repuesto</label>
                <input type="text" id="filtroSearch" name="search" value="@Model.Search"
                       class="form-control form-control-sm" placeholder="Nombre o código..." />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="filtroCategoria" class="form-label small text-muted mb-1">Categoría</label>
                <select id="filtroCategoria" name="categoria" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var c in SistemaTickets.Domain.Entities.Repuesto.Categorias)
                    {
                        <option value="@c" selected="@(Model.FiltroCategoria == c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-4 acciones-form d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Buscar</button>
                <a asp-action="Repuestos" class="btn btn-outline-secondary btn-sm flex-grow-1">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 tabla-apilable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width:50px">#</th>
                        <th>Nombre</th>
                        <th>Código</th>
                        <th>Categoría</th>
                        <th>Unidad</th>
                        <th>Precio</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Repuestos.Any())
                    {
                        <tr>
                            <td colspan="7" class="fila-vacia p-0">
                                <partial name="_EstadoVacio" model='("fa-solid fa-screwdriver-wrench", "No se encontraron repuestos.", (string?)null, (string?)null)' />
                            </td>
                        </tr>
                    }
                    else
                    {
                        var num = Model.DesdeRegistro;
                        @foreach (var r in Model.Repuestos)
                        {
                            var tieneAlerta = Model.StockAlerta.Any(s => s.Repuesto.Id == r.Id);
                            <tr>
                                <td data-label="#" class="ps-4 text-muted small">@num</td>
                                <td data-label="Nombre">
                                    <a asp-action="RepuestoDetails" asp-route-id="@r.Id"
                                       class="fw-semibold text-decoration-none text-dark">
                                        @r.Nombre
                                        @if (tieneAlerta)
                                        {
                                            <span class="badge bg-warning text-dark ms-1 small">Stock bajo</span>
                                        }
                                    </a>
                                </td>
                                <td data-label="Código" class="small text-muted">@(r.Codigo ?? "—")</td>
                                <td data-label="Categoría" class="small">@r.Categoria</td>
                                <td data-label="Unidad" class="small">@r.UnidadMedida</td>
                                <td data-label="Precio" class="small">
                                    @(r.PrecioUnitario > 0 ? r.PrecioUnitario.ToString("C") : "—")
                                </td>
                                <td class="text-end pe-4 celda-acciones">
                                    <a asp-action="RepuestoDetails" asp-route-id="@r.Id"
                                       class="btn btn-outline-primary btn-sm" title="Ver" aria-label="Ver">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                            num++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Func<int, string> urlPagina = n =>
        "?page=" + n + "&search=" + Uri.EscapeDataString(Model.Search ?? "") +
        "&categoria=" + Uri.EscapeDataString(Model.FiltroCategoria ?? "");
}
<partial name="_Paginacion" model="(Model.PaginaActual, Model.TotalPaginas, urlPagina)" />
