@model SistemaTickets.Models.Campo.VisitaIndexViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Visitas Técnicas";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Visitas Técnicas</h1>
        <small class="page-subtitle">
            Mostrando @Model.DesdeRegistro–@Model.HastaRegistro de @Model.TotalRegistros visitas
        </small>
    </div>
    <div class="page-actions">
        <a asp-action="Repuestos" class="btn btn-outline-primary btn-sm">Ver Repuestos</a>
        <a asp-action="VisitaCreate" class="btn btn-primary btn-sm px-3">+ Nueva Visita</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Visitas" class="row g-2 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label for="filtroSearch" class="form-label small text-muted mb-1">Buscar dirección</label>
                <input type="text" id="filtroSearch" name="search" value="@Model.Search"
                       class="form-control form-control-sm" placeholder="Dirección o descripción..." />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="filtroEstado" class="form-label small text-muted mb-1">Estado</label>
                <select id="filtroEstado" name="estado" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var e in SistemaTickets.Domain.Entities.VisitaTecnica.Estados)
                    {
                        <option value="@e" selected="@(Model.FiltroEstado == e)">@e</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-4 acciones-form d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Buscar</button>
                <a asp-action="Visitas" class="btn btn-outline-secondary btn-sm flex-grow-1">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 tabla-apilable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width:50px">#</th>
                        <th>Dirección</th>
                        <th>Fecha visita</th>
                        <th>Estado</th>
                        @if (role is "Administrador" or "Supervisor")
                        {
                            <th>Técnico</th>
                        }
                        <th>Ticket</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Visitas.Any())
                    {
                        <tr>
                            <td colspan="7" class="fila-vacia p-0">
                                <partial name="_EstadoVacio" model='("fa-solid fa-route", "No se encontraron visitas.", (string?)null, (string?)null)' />
                            </td>
                        </tr>
                    }
                    else
                    {
                        var num = Model.DesdeRegistro;
                        @foreach (var v in Model.Visitas)
                        {
                            var estadoColor = v.Estado switch
                            {
                                "Programada"  => "secondary",
                                "En Curso"    => "primary",
                                "Completada"  => "success",
                                "Cancelada"   => "danger",
                                _             => "secondary"
                            };
                            <tr>
                                <td data-label="#" class="ps-4 text-muted small">@num</td>
                                <td data-label="Dirección">
                                    <a asp-action="VisitaDetails" asp-route-id="@v.Id"
                                       class="fw-semibold text-decoration-none text-dark">
                                        @v.Direccion
                                    </a>
                                </td>
                                <td data-label="Fecha visita" class="small">@v.FechaVisita.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Estado"><span class="badge bg-@estadoColor">@v.Estado</span></td>
                                @if (role is "Administrador" or "Supervisor")
                                {
                                    <td data-label="Técnico" class="small text-muted">@v.Tecnico.NombreCompleto</td>
                                }
                                <td data-label="Ticket" class="small text-muted">
                                    @(v.Ticket is null ? "—" : $"#{v.Ticket.Id}")
                                </td>
                                <td class="text-end pe-4 celda-acciones">
                                    <a asp-action="VisitaDetails" asp-route-id="@v.Id"
                                       class="btn btn-outline-primary btn-sm" title="Ver" aria-label="Ver">
                                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                            num++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Func<int, string> urlPagina = n =>
        "?page=" + n + "&search=" + Uri.EscapeDataString(Model.Search ?? "") +
        "&estado=" + Uri.EscapeDataString(Model.FiltroEstado ?? "");
}
<partial name="_Paginacion" model="(Model.PaginaActual, Model.TotalPaginas, urlPagina)" />
