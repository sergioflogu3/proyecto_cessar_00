@model SistemaTickets.Models.Campo.RepuestoDetailsViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = $"Repuesto: {Model.Nombre}";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var esAdminOSupervisor = role is "Administrador" or "Supervisor";
    var stocks  = Model.Stocks;
    var sedes   = Model.Sedes;
}

@Html.AntiForgeryToken()

<div class="page-header align-items-start">
    <div class="min-w-0">
        <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
            <a asp-action="Repuestos" class="btn btn-outline-secondary btn-sm">← Repuestos</a>
            <span class="text-muted small flex-shrink-0">Repuesto #@Model.Id</span>
        </div>
        <h1 class="page-title mb-2">@Model.Nombre</h1>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="badge bg-secondary">@Model.Categoria</span>
            @if (!string.IsNullOrEmpty(Model.Codigo))
            {
                <span class="badge bg-light text-dark border">@Model.Codigo</span>
            }
            <span class="text-muted small">@Model.UnidadMedida</span>
        </div>
    </div>
    @if (esAdminOSupervisor)
    {
        <div class="page-actions acciones-icono">
            <a asp-action="RepuestoEdit" asp-route-id="@Model.Id"
               class="btn btn-outline-primary btn-sm" title="Editar" aria-label="Editar">
               <i class="fa-solid fa-pen" aria-hidden="true"></i>
            </a>
            @if (sedes.Any())
            {
                <button class="btn btn-outline-success btn-sm" id="btnAjustarStock" title="Ajustar stock" aria-label="Ajustar stock">
                    <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                </button>
            }
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">

        @* Stock por sede *@
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold">Stock por sede</span>
            </div>
            <div class="card-body p-0">
                @if (!stocks.Any())
                {
                    <partial name="_EstadoVacio" model='("fa-solid fa-boxes-stacked", "Sin stock registrado.", (string?)null, (string?)null)' />
                }
                else
                {
                    @foreach (var s in stocks)
                    {
                        var bajoBadge = s.BajoMinimo ? "bg-danger" : "bg-success";
                        <div class="d-flex justify-content-between align-items-center gap-3 border-bottom px-3 px-sm-4 py-3">
                            <div class="min-w-0 text-break">
                                <div class="fw-semibold small">@s.SedeNombre</div>
                                <div class="text-muted small">Mínimo: @s.CantidadMinima @Model.UnidadMedida</div>
                            </div>
                            <span class="badge @bajoBadge fs-6 flex-shrink-0">
                                @s.CantidadActual @Model.UnidadMedida
                                @if (s.BajoMinimo) {<span> ⚠</span>}
                            </span>
                        </div>
                    }
                }
            </div>
        </div>

        @* Historial de consumos *@
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold">Últimos consumos (@Model.Consumos.Count)</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Consumos.Any())
                {
                    <partial name="_EstadoVacio" model='("fa-solid fa-clipboard-list", "Sin consumos registrados.", (string?)null, (string?)null)' />
                }
                else
                {
                    @foreach (var c in Model.Consumos.OrderByDescending(x => x.FechaConsumo).Take(20))
                    {
                        <div class="d-flex justify-content-between align-items-center gap-3 border-bottom px-3 px-sm-4 py-3">
                            <div class="min-w-0 text-break">
                                <div class="fw-semibold small">@c.TecnicoNombreCompleto</div>
                                <div class="text-muted small">
                                    @c.FechaConsumo.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    @if (c.VisitaId is not null)
                                    {
                                        <span>· <a asp-controller="Campo" asp-action="VisitaDetails" asp-route-id="@c.VisitaId">Visita #@c.VisitaId</a></span>
                                    }
                                    @if (c.TicketId is not null)
                                    {
                                        <span>· <a asp-controller="Tickets" asp-action="Details" asp-route-id="@c.TicketId">Ticket #@c.TicketId</a></span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(c.Observaciones))
                                {<div class="text-muted small">@c.Observaciones</div>}
                            </div>
                            <span class="badge bg-primary fs-6 flex-shrink-0">@c.Cantidad @Model.UnidadMedida</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold">Información</span>
            </div>
            <ul class="list-group list-group-flush">
                @if (!string.IsNullOrEmpty(Model.Descripcion))
                {
                    <li class="list-group-item px-3 px-sm-4 py-2">
                        <div class="text-muted small mb-1">Descripción</div>
                        <div class="small text-break">@Model.Descripcion</div>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between gap-3 px-3 px-sm-4 py-2">
                    <span class="text-muted small flex-shrink-0">Categoría</span>
                    <span class="small text-end text-break min-w-0 fw-semibold">@Model.Categoria</span>
                </li>
                <li class="list-group-item d-flex justify-content-between gap-3 px-3 px-sm-4 py-2">
                    <span class="text-muted small flex-shrink-0">Unidad</span>
                    <span class="small text-end text-break min-w-0">@Model.UnidadMedida</span>
                </li>
                @if (Model.PrecioUnitario > 0)
                {
                    <li class="list-group-item d-flex justify-content-between gap-3 px-3 px-sm-4 py-2">
                        <span class="text-muted small flex-shrink-0">Precio unitario</span>
                        <span class="small text-end text-break min-w-0 fw-semibold">@Model.PrecioUnitario.ToString("C")</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between gap-3 px-3 px-sm-4 py-2">
                    <span class="text-muted small flex-shrink-0">Total consumos</span>
                    <span class="small text-end text-break min-w-0">@Model.Consumos.Count</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@* Modal ajustar stock *@
@if (esAdminOSupervisor)
{
    <div class="modal fade" id="stockModal" tabindex="-1" aria-labelledby="stockModalTitulo">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="stockModalTitulo">Ajustar Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="selectSede" class="form-label fw-semibold">Sede</label>
                        <select id="selectSede" class="form-select">
                            @foreach (var s in sedes)
                            {
                                <option value="@s.Id">@s.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="selectTipo" class="form-label fw-semibold">Tipo de movimiento</label>
                        <select id="selectTipo" class="form-select">
                            <option value="true">Entrada (sumar)</option>
                            <option value="false">Salida (restar)</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label for="txtCantidad" class="form-label fw-semibold">Cantidad</label>
                        <input type="number" id="txtCantidad" class="form-control" value="1" min="1" />
                    </div>
                    <div id="errorStock" class="alert alert-danger py-2 small d-none mt-2" role="alert"></div>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success px-4" id="confirmarStock">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    const csrf      = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const repuestoId = @Model.Id;

    const btnAjustar = document.getElementById('btnAjustarStock');
    if (btnAjustar) {
        btnAjustar.addEventListener('click', () => {
            new bootstrap.Modal(document.getElementById('stockModal')).show();
        });

        document.getElementById('confirmarStock').addEventListener('click', async () => {
            const sedeId    = document.getElementById('selectSede').value;
            const esEntrada = document.getElementById('selectTipo').value;
            const cantidad  = document.getElementById('txtCantidad').value;
            const errBox    = document.getElementById('errorStock');

            if (!cantidad || cantidad < 1) {
                errBox.textContent = 'La cantidad debe ser mayor a 0.';
                errBox.classList.remove('d-none');
                return;
            }
            errBox.classList.add('d-none');

            const fd = new FormData();
            fd.append('repuestoId', repuestoId);
            fd.append('sedeId', sedeId);
            fd.append('cantidad', cantidad);
            fd.append('esEntrada', esEntrada);
            fd.append('__RequestVerificationToken', csrf);

            const res = await fetch('/Campo/AjustarStock', { method: 'POST', body: fd });
            const r   = await res.json();
            r.success ? window.location.reload() : (errBox.textContent = r.message, errBox.classList.remove('d-none'));
        });
    }
</script>
}
